# Chaves públicas do projeto Supabase (a anon key é pública por design).
# Copie para .env e preencha com os valores do seu projeto.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Opcional: token da Management API usado apenas por scripts/run-sql.mjs.
# Nunca faça commit desse valor.
# SUPABASE_ACCESS_TOKEN=
